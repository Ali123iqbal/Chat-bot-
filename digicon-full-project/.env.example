# Leadership access tokens for the dev auth adapter: "token:userId,token2:userId2"
# Use long random values. Replace the adapter with your real sign-in later.
DIGICON_LEADERSHIP_TOKENS=

# Where the validated active dataset and status live (default ./data)
DIGICON_DATA_DIR=./data

# Student ID format (regex). Default matches 20231-33987
DIGICON_ID_PATTERN=^\d{5}-\d{5}$

# Only needed if your CSV export contains an acceptance column.
# The importer refuses such files unless BOTH are set.
DIGICON_ACCEPT_COLUMN=
DIGICON_ACCEPT_VALUE=

# Conversation idle timeout in minutes (default 30)
DIGICON_IDLE_MINUTES=30
